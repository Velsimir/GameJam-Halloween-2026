MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 928545dc5ece41e4b9fcad6829c3378f, type: 3}
  m_Name: StringTable_Main
  m_EditorClassIdentifier: Velsi.Typecraft.Runtime::Velsi.Typecraft.Text.Tables.StringTable
  _tableId: Main
  _entries:
  - _key: ui.door.locked
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u0443 \u0437\u0430\u043F\u0435\u0440\u0442\u043E\u0439
      \u0434\u0432\u0435\u0440\u0438"
    _values:
    - _locale: en
      _text: The door is [warn]locked[/warn]. Press {key:Interact} to inspect the
        lock.
    - _locale: ru
      _text: "\u0414\u0432\u0435\u0440\u044C [warn]\u0437\u0430\u043F\u0435\u0440\u0442\u0430[/warn].
        \u041D\u0430\u0436\u043C\u0438 {key:Interact}, \u0447\u0442\u043E\u0431\u044B
        \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0437\u0430\u043C\u043E\u043A."
    - _locale: zh-Hans
      _text: "\u95E8[warn]\u9501\u7740[/warn]\u3002\u6309 {key:Interact} \u68C0\u67E5\u95E8\u9501\u3002"
  - _key: ui.whisper.still_here
    _comment: "\u0428\u0451\u043F\u043E\u0442 \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
      \u0434\u0432\u0435\u0440\u0438"
    _values:
    - _locale: en
      _text: "[whisper]It is still here\u2026[/whisper]"
    - _locale: ru
      _text: "[whisper]\u041E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C\u2026[/whisper]"
  - _key: ui.location.basement
    _comment: "\u0417\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A \u043B\u043E\u043A\u0430\u0446\u0438\u0438"
    _values:
    - _locale: en
      _text: '[title]Basement[/title]'
    - _locale: ru
      _text: "[title]\u041F\u043E\u0434\u0432\u0430\u043B[/title]"
    - _locale: zh-Hans
      _text: "[title]\u5730\u4E0B\u5BA4[/title]"
  - _key: ui.interact.open
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u043E\u0442\u043A\u0440\u044B\u0442\u044C"
    _values:
    - _locale: en
      _text: Open {key:Interact}
    - _locale: ru
      _text: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C {key:Interact}"
  - _key: ui.interact.close
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u0437\u0430\u043A\u0440\u044B\u0442\u044C"
    _values:
    - _locale: en
      _text: Close {key:Interact}
    - _locale: ru
      _text: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C {key:Interact}"
  - _key: ui.interact.inspect
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C"
    _values:
    - _locale: en
      _text: Inspect {key:Interact}
    - _locale: ru
      _text: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C {key:Interact}"
  - _key: ui.interact.take
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u0432\u0437\u044F\u0442\u044C"
    _values:
    - _locale: en
      _text: Take {key:Interact}
    - _locale: ru
      _text: "\u0412\u0437\u044F\u0442\u044C {key:Interact}"
  - _key: ui.thought.cold
    _comment: "\u0422\u0435\u0441\u0442\u043E\u0432\u0430\u044F \u043C\u044B\u0441\u043B\u044C:
      \u0445\u043E\u043B\u043E\u0434"
    _values:
    - _locale: en
      _text: "[whisper]It is so cold in here\u2026[/whisper]"
    - _locale: ru
      _text: "[whisper]\u0417\u0434\u0435\u0441\u044C \u0442\u0430\u043A \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u2026[/whisper]"
  - _key: ui.thought.watching
    _comment: "\u0422\u0435\u0441\u0442\u043E\u0432\u0430\u044F \u043C\u044B\u0441\u043B\u044C:
      \u0432\u0437\u0433\u043B\u044F\u0434"
    _values:
    - _locale: en
      _text: I feel [warn]someone is watching[/warn] me.
    - _locale: ru
      _text: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, [warn]\u0437\u0430 \u043C\u043D\u043E\u0439
        \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442[/warn]."
  - _key: ui.inspect.box.1
    _comment: "\u041E\u0441\u043C\u043E\u0442\u0440: \u044F\u0449\u0438\u043A 1"
    _values:
    - _locale: en
      _text: Just an old crate. Nothing special.
    - _locale: ru
      _text: "\u0421\u0442\u0430\u0440\u044B\u0439 \u044F\u0449\u0438\u043A. \u041D\u0438\u0447\u0435\u0433\u043E
        \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0433\u043E."
  - _key: ui.inspect.box.2
    _comment: "\u041E\u0441\u043C\u043E\u0442\u0440: \u044F\u0449\u0438\u043A 2"
    _values:
    - _locale: en
      _text: 'The lid is nailed shut. [warn]From the inside?[/warn]'
    - _locale: ru
      _text: "\u041A\u0440\u044B\u0448\u043A\u0430 \u0437\u0430\u0431\u0438\u0442\u0430
        \u0433\u0432\u043E\u0437\u0434\u044F\u043C\u0438. [warn]\u0418\u0437\u043D\u0443\u0442\u0440\u0438?[/warn]"
  - _key: ui.inspect.box.3
    _comment: "\u041E\u0441\u043C\u043E\u0442\u0440: \u044F\u0449\u0438\u043A 3"
    _values:
    - _locale: en
      _text: I should stop staring at it.
    - _locale: ru
      _text: "\u0425\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E
        \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
  - _key: ui.inspect.doll.1
    _comment: "\u041E\u0441\u043C\u043E\u0442\u0440: \u043A\u0443\u043A\u043B\u0430"
    _values:
    - _locale: en
      _text: '[warn]Its eyes just moved.[/warn]'
    - _locale: ru
      _text: "[warn]\u0415\u0451 \u0433\u043B\u0430\u0437\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0447\u0442\u043E \u0448\u0435\u0432\u0435\u043B\u044C\u043D\u0443\u043B\u0438\u0441\u044C.[/warn]"
  - _key: item.key.name
    _comment: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442: \u043A\u043B\u044E\u0447"
    _values:
    - _locale: en
      _text: Key
    - _locale: ru
      _text: "\u041A\u043B\u044E\u0447"
  - _key: ui.thought.key_taken
    _comment: "\u041C\u044B\u0441\u043B\u044C \u043F\u0440\u0438 \u043F\u043E\u0434\u0431\u043E\u0440\u0435
      \u043A\u043B\u044E\u0447\u0430"
    _values:
    - _locale: en
      _text: Rusty key. It must fit something.
    - _locale: ru
      _text: "\u0420\u0436\u0430\u0432\u044B\u0439 \u043A\u043B\u044E\u0447. \u041E\u043D
        \u0434\u043E\u043B\u0436\u0435\u043D \u0447\u0442\u043E-\u0442\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C."
  - _key: ui.thought.door_locked
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u0434\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0435\u0440\u0442\u0430"
    _values:
    - _locale: en
      _text: Locked. I need a key.
    - _locale: ru
      _text: "\u0417\u0430\u043F\u0435\u0440\u0442\u043E. \u041D\u0443\u0436\u0435\u043D
        \u043A\u043B\u044E\u0447."
  - _key: ui.thought.door_unlocked
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043F\u0435\u0440\u0442\u0430"
    _values:
    - _locale: en
      _text: The key fits.
    - _locale: ru
      _text: "\u041A\u043B\u044E\u0447 \u043F\u043E\u0434\u043E\u0448\u0451\u043B."
  - _key: ui.interact.go
    _comment: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u043F\u0440\u043E\u0439\u0442\u0438"
    _values:
    - _locale: en
      _text: Go through {key:Interact}
    - _locale: ru
      _text: "\u041F\u0440\u043E\u0439\u0442\u0438 {key:Interact}"
  - _key: ui.thought.corridor_enter
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u0432\u0445\u043E\u0434 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440"
    _values:
    - _locale: en
      _text: "It is so quiet here\u2026"
    - _locale: ru
      _text: "\u0417\u0434\u0435\u0441\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C
        \u0442\u0438\u0445\u043E\u2026"
  - _key: ui.thought.room_enter
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u0432\u043E\u0437\u0432\u0440\u0430\u0442
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    _values:
    - _locale: en
      _text: Back in the room. Something feels different.
    - _locale: ru
      _text: "\u0421\u043D\u043E\u0432\u0430 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435.
        \u0427\u0442\u043E-\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C."
  - _key: ui.thought.neighbor_door
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u0434\u0432\u0435\u0440\u044C \u0441\u043E\u0441\u0435\u0434\u0430
      (\u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430)"
    _values:
    - _locale: en
      _text: 'TODO: Not my door.'
    - _locale: ru
      _text: "TODO: \u042D\u0442\u043E \u043D\u0435 \u043C\u043E\u044F \u0434\u0432\u0435\u0440\u044C."
  - _key: ui.thought.stairs_up_closed
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430
      \u043D\u0430\u0432\u0435\u0440\u0445 \u0437\u0430\u043A\u0440\u044B\u0442\u0430
      (\u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430)"
    _values:
    - _locale: en
      _text: 'TODO: The grate is locked.'
    - _locale: ru
      _text: "TODO: \u0420\u0435\u0448\u0451\u0442\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430."
  - _key: ui.thought.stairs_down
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430
      \u0432\u043D\u0438\u0437 (\u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430)"
    _values:
    - _locale: en
      _text: 'TODO: Stairs down.'
    - _locale: ru
      _text: "TODO: \u041B\u0435\u0441\u0442\u043D\u0438\u0446\u0430 \u0432\u043D\u0438\u0437."
  - _key: ui.thought.block_door_locked
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u0437\u0430\u043F\u0435\u0440\u0442\u0430\u044F
      \u0434\u0432\u0435\u0440\u044C \u0431\u043B\u043E\u043A\u0430 (\u0437\u0430\u0433\u043B\u0443\u0448\u043A\u0430)"
    _values:
    - _locale: en
      _text: 'TODO: Locked.'
    - _locale: ru
      _text: "TODO: \u0417\u0430\u043F\u0435\u0440\u0442\u043E."
  - _key: ui.thought.scenario_not_now
    _comment: "\u041C\u044B\u0441\u043B\u044C: \u0446\u0435\u043B\u044C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u0430"
    _values:
    - _locale: en
      _text: 'TODO: Not now.'
    - _locale: ru
      _text: "TODO: \u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441."
  - _key: ui.day.01.title
    _comment: "\u0417\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A \u0434\u043D\u044F
      1 (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Day 1'
    - _locale: ru
      _text: "TODO: \u0414\u0435\u043D\u044C 1"
  - _key: ui.objective.day01_wash
    _comment: "\u0417\u0430\u0434\u0430\u0447\u0430 \u0434\u043D\u044F 1: \u0443\u043C\u044B\u0442\u044C\u0441\u044F
      (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Wash up'
    - _locale: ru
      _text: "TODO: \u0423\u043C\u044B\u0442\u044C\u0441\u044F"
  - _key: ui.thought.day01_wash
    _comment: "\u041C\u044B\u0441\u043B\u044C \u0434\u043D\u044F 1: \u0443\u043C\u044B\u0442\u044C\u0441\u044F
      (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: I need to wash my face.'
    - _locale: ru
      _text: "TODO: \u041D\u0430\u0434\u043E \u0443\u043C\u044B\u0442\u044C\u0441\u044F."
  - _key: ui.thought.day01_wash_remind
    _comment: "\u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0434\u043D\u044F 1: \u0443\u043C\u044B\u0442\u044C\u0441\u044F (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: First the bathroom.'
    - _locale: ru
      _text: "TODO: \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432 \u0432\u0430\u043D\u043D\u0443\u044E."
  - _key: ui.objective.day01_keys
    _comment: "\u0417\u0430\u0434\u0430\u0447\u0430 \u0434\u043D\u044F 1: \u0432\u0437\u044F\u0442\u044C
      \u043A\u043B\u044E\u0447\u0438 (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Take the keys'
    - _locale: ru
      _text: "TODO: \u0412\u0437\u044F\u0442\u044C \u043A\u043B\u044E\u0447\u0438"
  - _key: ui.thought.day01_keys
    _comment: "\u041C\u044B\u0441\u043B\u044C \u0434\u043D\u044F 1: \u0433\u0434\u0435
      \u043A\u043B\u044E\u0447\u0438 (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Where are my keys? On the hook by the door.'
    - _locale: ru
      _text: "TODO: \u0413\u0434\u0435 \u043A\u043B\u044E\u0447\u0438? \u041D\u0430
        \u043A\u0440\u044E\u0447\u043A\u0435 \u0443 \u0434\u0432\u0435\u0440\u0438."
  - _key: ui.thought.day01_keys_remind
    _comment: "\u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0434\u043D\u044F 1: \u043A\u043B\u044E\u0447\u0438 (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: The keys are by the front door.'
    - _locale: ru
      _text: "TODO: \u041A\u043B\u044E\u0447\u0438 \u0443 \u0432\u0445\u043E\u0434\u043D\u043E\u0439
        \u0434\u0432\u0435\u0440\u0438."
  - _key: ui.thought.day01_keys_taken
    _comment: "\u041C\u044B\u0441\u043B\u044C \u043F\u0440\u0438 \u043F\u043E\u0434\u0431\u043E\u0440\u0435
      \u043A\u043B\u044E\u0447\u0435\u0439 \u043E\u0442 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B
      (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Got the keys.'
    - _locale: ru
      _text: "TODO: \u041A\u043B\u044E\u0447\u0438 \u0443 \u043C\u0435\u043D\u044F."
  - _key: item.keys_apartment.name
    _comment: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442: \u043A\u043B\u044E\u0447\u0438
      \u043E\u0442 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Apartment keys'
    - _locale: ru
      _text: "TODO: \u041A\u043B\u044E\u0447\u0438 \u043E\u0442 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B"
  - _key: ui.objective.day01_leave
    _comment: "\u0417\u0430\u0434\u0430\u0447\u0430 \u0434\u043D\u044F 1: \u0432\u044B\u0439\u0442\u0438
      \u0438\u0437 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Leave the apartment'
    - _locale: ru
      _text: "TODO: \u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B"
  - _key: ui.thought.day01_leave
    _comment: "\u041C\u044B\u0441\u043B\u044C \u0434\u043D\u044F 1: \u043F\u043E\u0440\u0430
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C (\u0442\u0435\u0441\u0442)"
    _values:
    - _locale: en
      _text: 'TODO: Time to go.'
    - _locale: ru
      _text: "TODO: \u041F\u043E\u0440\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C."
  - _key: ui.thought.day01_leave_remind
    _comment: "\u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0434\u043D\u044F 1: \u0432\u044B\u0439\u0442\u0438 (\u0442\u0435\u0441\u0442)"
    _values:
